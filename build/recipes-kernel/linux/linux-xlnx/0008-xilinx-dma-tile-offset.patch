+static int xvip_dma_get_active_layout(struct xvip_dma *dma, u32 *stride,
+				      size_t *row_size,
+				      u32 *height)
+{
+	u32 padding_factor_nume, padding_factor_deno;
+	u32 bpl_nume, bpl_deno;
+	u32 pixelformat;
+	size_t numerator;
+	size_t denominator;
+
+	if (!dma->fmtinfo)
+		return -EINVAL;
+
+	if (V4L2_TYPE_IS_MULTIPLANAR(dma->format.type)) {
+		struct v4l2_pix_format_mplane *pix_mp = &dma->format.fmt.pix_mp;
+
+		pixelformat = pix_mp->pixelformat;
+		*stride = pix_mp->plane_fmt[0].bytesperline;
+	} else {
+		struct v4l2_pix_format *pix = &dma->format.fmt.pix;
+
+		pixelformat = pix->pixelformat;
+		*stride = pix->bytesperline;
+	}
+
+	xvip_width_padding_factor(pixelformat, &padding_factor_nume,
+				  &padding_factor_deno);
+	xvip_bpl_scaling_factor(pixelformat, &bpl_nume, &bpl_deno);
+
+	if (!padding_factor_deno || !bpl_deno ||
+	    check_mul_overflow((size_t)dma->r.width,
+			       (size_t)dma->fmtinfo->bpl_factor, &numerator) ||
+	    check_mul_overflow(numerator, (size_t)padding_factor_nume,
+			       &numerator) ||
+	    check_mul_overflow(numerator, (size_t)bpl_nume, &numerator) ||
+	    check_mul_overflow((size_t)padding_factor_deno,
+			       (size_t)bpl_deno, &denominator))
+		return -EOVERFLOW;
+
+	*row_size = numerator / denominator;
+	*height = dma->r.height;
+	if (!*height || !*row_size || *row_size > *stride)
+		return -EINVAL;
+
+	return 0;
+}
+
 static int xvip_dma_buffer_prepare(struct vb2_buffer *vb)
 {
 	struct vb2_v4l2_buffer *vbuf = to_vb2_v4l2_buffer(vb);
 	struct xvip_dma *dma = vb2_get_drv_priv(vb->vb2_queue);
 	struct xvip_dma_buffer *buf = to_xvip_dma_buffer(vbuf);
+	dma_addr_t addr;
+	dma_addr_t dst_addr;
+	size_t active_span;
+	size_t plane_size;
+	size_t row_size;
+	u32 stride;
+	u32 height;
+	int ret;

 	buf->dma = dma;

+	if (!dma->tile_offset)
+		return 0;
+
+	/* Bounds below describe one image plane. A single vb2 memory plane can
+	 * still contain multiple image planes. Reject those layouts until their
+	 * complete footprint is validated. */
+	if (vb->num_planes != 1 || dma->fmtinfo->num_planes != 1)
+		return -EOPNOTSUPP;
+
+	if (!IS_ALIGNED(dma->tile_offset, dma->align)) {
+		dev_err(dma->xdev->dev,
+			"tile offset 0x%x is not %u-byte aligned\n",
+			dma->tile_offset, dma->align);
+		return -EINVAL;
+	}
+
+	ret = xvip_dma_get_active_layout(dma, &stride, &row_size, &height);
+	if (ret)
+		return ret;
+
+	if ((size_t)(dma->tile_offset % stride) >
+	    (size_t)stride - row_size) {
+		dev_err(dma->xdev->dev,
+			"tile offset 0x%x places row size 0x%zx beyond stride 0x%x\n",
+			dma->tile_offset, row_size, stride);
+		return -EINVAL;
+	}
+
+	if (check_mul_overflow((size_t)(height - 1), (size_t)stride,
+			       &active_span) ||
+	    check_add_overflow(active_span, row_size, &active_span))
+		return -EOVERFLOW;
+
+	plane_size = vb2_plane_size(vb, 0);
+	if (dma->tile_offset > plane_size ||
+	    active_span > plane_size - dma->tile_offset) {
+		dev_err(dma->xdev->dev,
+			"tile offset 0x%x plus active span 0x%zx exceeds plane size 0x%zx\n",
+			dma->tile_offset, active_span, plane_size);
+		return -EINVAL;
+	}
+
+	addr = vb2_dma_contig_plane_dma_addr(vb, 0);
+	if (check_add_overflow(addr, (dma_addr_t)dma->tile_offset, &dst_addr))
+		return -EOVERFLOW;
+	if (!IS_ALIGNED(dst_addr, dma->align))
+		return -EINVAL;
+
 	return 0;
 }

