ROOT := $(src)

ccflags-y += -I$(ROOT)/
# uAPI - use -iquote to prioritize local header over in-tree kernel header
ccflags-y += -iquote$(ROOT)/../../../include/uapi
# version.h and trace headers - use -iquote to prioritize over in-tree kernel headers
ccflags-y += -iquote$(ROOT)/../../../include
# For define_trace.h re-inclusion with TRACE_INCLUDE_PATH=.
ccflags-y += -iquote$(ROOT)/../../../include/trace/events
# Make every C file in this dir see config-kernel.h
ccflags-y += -include $(ROOT)/config_kernel.h

# All warning will report as error and debug build
ccflags-y += -g -Werror

ccflags-${UMQ_HELLO_TEST} += -DUMQ_HELLO_TEST

obj-m	+= amdxdna.o
# Only objects that have corresponding .c sources in this directory
amdxdna-y := \
	amdxdna_ctx.o \
	amdxdna_drm.o \
	amdxdna_gem.o \
	amdxdna_iommu.o \
	amdxdna_mailbox_helper.o \
	amdxdna_pm.o \
	amdxdna_sysfs.o \
	amdxdna_ubuf.o \
	amdxdna_cbuf.o \
	amdxdna_cma_buf.o \
	amdxdna_xen.o \
	amdxdna_sensors.o

amdxdna-y += \
	aie.o \
	aie4_ctx.o \
	aie4_error.o \
	aie4_message.o \
	amdxdna_dpt.o \
	amdxdna_error.o \
	amdxdna_coredump.o \
	amdxdna_ctx_status.o \
	amdxdna_tile_read_write.o

# The aie2 PCI driver uses the DRM GPU scheduler; the non-PCI builds (npu12
# platform, VE2) target parts whose kernels may be built without DRM_SCHED, so
# the aie2 driver, its PSP/SMU layer and its PCI register tables are not
# compiled there. (aie.o is the shared mgmt-mailbox layer and stays in every
# build.)
ifeq ($(CONFIG_DRM_ACCEL_AMDXDNA_PLAT)$(CONFIG_DRM_ACCEL_AMDXDNA_VE2),)
amdxdna-y += \
	aie_psp.o \
	aie_smu.o \
	aie2_ctx.o \
	aie2_error.o \
	aie2_message.o \
	aie2_pci.o \
	aie2_pm.o \
	aie2_solver.o \
	aie2_tdr.o \
	npu1_regs.o \
	npu4_regs.o \
	npu5_regs.o \
	npu6_regs.o
endif

# Transport select. Each mailbox .c defines struct mailbox and xdna_mailbox_send_msg,
# and each side defines the aie4 transport hooks, so only one is built:
#   PCI    — BAR ring + MSI-X (amdxdna_mailbox.c)
#   PLAT   — shared-memory rings + IPI (amdxdna_mailbox_plat.c), npu12
#   VE2    — no mailbox IP; opcodes are carried out through the Xilinx AIE driver
#            (amdxdna_mailbox_ve2.c)
# Out-of-tree bridge: in-tree, Kconfig makes these configs C macros via autoconf.h,
# so IS_ENABLED() works. Here they are only Make variables, so define the macros
# ourselves; the source keeps using IS_ENABLED() unchanged.
ifneq ($(CONFIG_DRM_ACCEL_AMDXDNA_PLAT),)
ifneq ($(CONFIG_DRM_ACCEL_AMDXDNA_VE2),)
$(error CONFIG_DRM_ACCEL_AMDXDNA_PLAT and CONFIG_DRM_ACCEL_AMDXDNA_VE2 both define the mailbox transport; build only one)
endif
endif

ifneq ($(CONFIG_DRM_ACCEL_AMDXDNA_PLAT),)
ccflags-y += -DCONFIG_DRM_ACCEL_AMDXDNA_PLAT=1
amdxdna-y += \
	aie4.o \
	aie4_debugfs.o \
	aie4_dpt.o \
	aie4_plat.o \
	amdxdna_dpt_plat.o \
	amdxdna_mailbox_plat.o \
	amdxdna_plat_drv.o \
	npu12_regs.o
else ifneq ($(CONFIG_DRM_ACCEL_AMDXDNA_VE2),)
ccflags-y += -DCONFIG_DRM_ACCEL_AMDXDNA_VE2=1
amdxdna-y += \
	aie4.o \
	aie4_debugfs.o \
	aie4_dpt.o \
	aie4_ve2.o \
	amdxdna_dpt_plat.o \
	amdxdna_mailbox_ve2.o \
	ve2_aie.o \
	amdxdna_ve2_drv.o \
	ve2_regs.o
else
amdxdna-y += \
	aie4_pci.o \
	amdxdna_dpt_pci.o \
	amdxdna_mailbox.o \
	amdxdna_pci_drv.o \
	npu3_regs.o

# SR-IOV is PCI-only (to_pci_dev()/pci_enable_sriov()/PCI config space), so keep
# it in the PCI-only branch: the non-PCI modules must not pull it in even when
# CONFIG_PCI_IOV is set.
amdxdna-$(CONFIG_PCI_IOV) += \
	aie4_sriov.o
endif

amdxdna-$(CONFIG_DEBUG_FS) += \
	amdxdna_debugfs.o
