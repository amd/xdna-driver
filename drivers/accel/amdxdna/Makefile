KERNEL_VER ?= $(shell uname -r)
KERNEL_SRC ?= /lib/modules/$(KERNEL_VER)/build

mkfile_path = $(abspath $(lastword $(MAKEFILE_LIST)))
SRC_DIR = $(patsubst %/,%,$(dir $(mkfile_path)))
BUILD_ROOT_DIR := $(SRC_DIR)/build

ifeq ($(BUILD_ROOT_DIR),$(SRC_DIR))
$(error BUILD_ROOT_DIR and SRC_DIR can NOT be the same)
endif

.PHONY: all clean modules modules_install copy_ko

all: $(BUILD_ROOT_DIR)
	$(MAKE) -C $(BUILD_ROOT_DIR)/drivers/accel/$(notdir $(SRC_DIR)) modules

# add EXTRA_CFLAGS='-save-temps' to keep intermedia files
DEFINES := -DAMDXDNA_DEVEL

# Driver version
XDNA_DRIVER_VERSION ?= 2.21.0
XDNA_DATE ?= $(shell date +%Y%m%d)
XDNA_HASH ?= $(shell git rev-parse HEAD)

ifndef MODULE_VER_STR
MODULE_VER_STR := $(XDNA_DRIVER_VERSION)_$(XDNA_DATE),$(XDNA_HASH)
endif

DEFINES += -DMODULE_VER_STR='\"$(MODULE_VER_STR)\"'

# Not upstreamed: enabled via build.sh -npu3a (XDNA_DRV_BLD_FLAGS), forwarded
# to both the native build and the DKMS rebuild so the macro survives packaging.
ifeq ($(AMDXDNA_NPU3A),1)
DEFINES += -DAMDXDNA_NPU3A
endif

# Compiler (gcc/clang) comes from the LLVM= kbuild var set by DKMS/caller, not probed here (#1377)
# config_kernel.h is generated by CMake (native build) or DKMS PRE_BUILD; fail fast if missing.
modules:
	@cfg_script="$(SRC_DIR)/../tools/configure_kernel.sh"; \
	[ -f "$$cfg_script" ] || cfg_script="$(SRC_DIR)/../../../configure_kernel.sh"; \
	test -f "$(SRC_DIR)/config_kernel.h" || \
		{ echo "[ERROR] config_kernel.h missing. Run CMake or: KERNEL_SRC=$(KERNEL_SRC) OUT=$(SRC_DIR)/config_kernel.h sh $$cfg_script"; exit 1; }
	$(MAKE) -C $(KERNEL_SRC) M=$(SRC_DIR) CFLAGS_MODULE="$(DEFINES)" modules

modules_install:
	$(MAKE) -C $(KERNEL_SRC) M=$(SRC_DIR) modules_install

$(BUILD_ROOT_DIR): $(SRC_DIR)
	@echo "[INFO] BUILD Directory not exist or SRC Directory is newer"
	@echo "[INFO] Re-Generate BUILD_ROOT_DIR: $(BUILD_ROOT_DIR)"
	@rm -rf $@
	@$(eval TMP_DIR := $(shell mktemp -d))
	@mkdir -p $(TMP_DIR)/drivers/accel
	@cp -rs $(SRC_DIR) $(TMP_DIR)/drivers/accel
	@cp -rs $(SRC_DIR)/../../../include $(TMP_DIR)
	@mv $(TMP_DIR) $(BUILD_ROOT_DIR)

copy_ko:
	@find $(BUILD_ROOT_DIR) -mindepth 2 -name "*.ko" -type f -exec cp -f {} $(BUILD_ROOT_DIR) \;

clean:
	rm -rf $(BUILD_ROOT_DIR)
	rm -rf *.o *.cmd .*.cmd *.ko *.dwo *.mod* modules.order Module.symvers
